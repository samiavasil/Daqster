@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam componentStyle uml2

title Plugin Component Architecture (v2.3)

package "src/plugins/external_libs/" {
  [nodeeditor\n(QtNodes)] as NODEEDITOR
  [qtrest_lib] as QTREST
}

package "src/plugins/node_editor_ide/" <<Rectangle>> {
  [NodeEditorIde\n(NodeEditorPluginIde)] as IDE
  [NodeEditorWidget] as NEW
  [NodeEditorLibrary] as NEL
}

package "src/plugins/demo_nodeditor_nodes/" <<Rectangle>> {
  [DemoNodeEditorNodes\n(DemoNodeEditorNodesPlugin)] as DEMO
}

package "src/plugins/requirements_manager/" <<Rectangle>> {
  [RequirementsManager\n(RequirementsManagerPlugin)] as RM
}

package "src/plugins/QtCoinTrader/" <<Rectangle>> {
  [QtCoinTraderPlugin] as QCT
}

package "src/plugins/tests/" <<Rectangle>> {
  [test plugins\n(DAQSTER_BUILD_TEST_PLUGINS)] as TEST
}

package "src/frame_work/" <<Rectangle>> {
  [frame_work] as FW
  [QPluginManager] as QPM
}

package "src/apps/Daqster/" <<Rectangle>> {
  [Daqster App] as HOST
}

' Dependencies
NEW --> NODEEDITOR : links PUBLIC\n(QtNodes)
IDE --> NEL : links
IDE --> NODEEDITOR : links PUBLIC\n(QtNodes)
IDE --> FW : links
NEL --> NODEEDITOR : links PUBLIC\n(QtNodes)
NEL --> FW : links

DEMO --> NEL : links
DEMO --> NODEEDITOR : links PUBLIC\n(QtNodes)
DEMO --> FW : links

RM --> FW : links

QCT --> QTREST : links
QCT --> FW : links

HOST --> QPM : uses
QPM ..> IDE : discovers
QPM ..> DEMO : discovers
QPM ..> RM : discovers
QPM ..> QCT : discovers
QPM ..> TEST : discovers (optional)

note right of NEW
  Part of node_editor_ide
  NodeEditorWidget.{h,cpp}
  Qt Widgets GUI for
  node-based editors
end note

note right of IDE
  APPLICATION_PLUGIN
  IDE shell + built-in nodes
  (NumberSource, NumberDisplay,
  Modulo, ArithmeticLogic)
end note

note right of NEL
  SHARED library
  ChatGraphModel + shared
  node types/decoders
end note

note right of TEST
  Built only when
  DAQSTER_BUILD_TEST_PLUGINS=ON
end note

@enduml