/* ============================================
   Daqster Modern Dark Theme — Cyan Accent
   ============================================ */

/* --- Global --- */
* {
    font-family: "Segoe UI", "Noto Sans", "Ubuntu", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QWidget {
    color: #d0d0d0;
    background-color: #0d1117;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

/* --- ToolBar --- */
QToolBar {
    background-color: #161b22;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #21262d;
    margin: 6px 4px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 12px;
    color: #8b949e;
    font-weight: 500;
    min-width: 48px;
    min-height: 48px;
}

QToolButton:hover {
    background-color: #1c2128;
    border: 1px solid #30363d;
    color: #c9d1d9;
}

QToolButton:pressed {
    background-color: #1f6feb22;
    border: 1px solid #1f6feb55;
    color: #58a6ff;
}

QToolButton:checked {
    background-color: #1f6feb33;
    border: 1px solid #1f6feb;
    color: #58a6ff;
}

/* --- MenuBar --- */
QMenuBar {
    background-color: #0d1117;
    border-bottom: 1px solid #21262d;
    padding: 2px 0;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
    color: #8b949e;
}

QMenuBar::item:selected {
    background-color: #1c2128;
    color: #c9d1d9;
}

QMenuBar::item:pressed {
    background-color: #1f6feb33;
    color: #58a6ff;
}

/* --- Menu --- */
QMenu {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 6px 0;
}

QMenu::item {
    padding: 8px 24px 8px 16px;
    color: #c9d1d9;
    border-radius: 6px;
    margin: 2px 6px;
}

QMenu::item:selected {
    background-color: #1f6feb33;
    color: #58a6ff;
}

QMenu::item:disabled {
    color: #484f58;
}

QMenu::separator {
    height: 1px;
    background-color: #21262d;
    margin: 4px 12px;
}

/* --- PushButton --- */
QPushButton {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px 16px;
    color: #c9d1d9;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1f6feb33;
    border-color: #1f6feb;
    color: #58a6ff;
}

QPushButton:disabled {
    background-color: #161b22;
    border-color: #21262d;
    color: #484f58;
}

/* --- Primary / Accent Button --- */
QPushButton#primaryButton, QPushButton[primaryButton="true"] {
    background-color: #1f6feb;
    border: 1px solid #388bfd;
    color: #ffffff;
}

QPushButton#primaryButton:hover, QPushButton[primaryButton="true"]:hover {
    background-color: #388bfd;
    border-color: #58a6ff;
}

/* --- Danger / Red Button --- */
QPushButton#dangerButton, QPushButton[dangerButton="true"] {
    background-color: #da363322;
    border: 1px solid #f8514966;
    color: #f85149;
}

QPushButton#dangerButton:hover, QPushButton[dangerButton="true"]:hover {
    background-color: #f8514922;
    border-color: #f85149;
}

/* --- LineEdit --- */
QLineEdit {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px 12px;
    color: #c9d1d9;
    selection-background-color: #1f6feb;
}

QLineEdit:focus {
    border: 1px solid #1f6feb;
}

QLineEdit:disabled {
    background-color: #161b22;
    border-color: #21262d;
    color: #484f58;
}

/* --- TextEdit / PlainTextEdit --- */
QTextEdit, QPlainTextEdit {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px;
    color: #c9d1d9;
    selection-background-color: #1f6feb;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #1f6feb;
}

/* --- ComboBox --- */
QComboBox {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 6px 12px;
    color: #c9d1d9;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #8b949e;
}

QComboBox:on {
    border: 1px solid #1f6feb;
    background-color: #1c2128;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #30363d;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8b949e;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #1f6feb33;
    selection-color: #58a6ff;
    outline: none;
}

/* --- ScrollBar --- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #30363d;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #30363d;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #484f58;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* --- TabWidget / TabBar --- */
QTabWidget::pane {
    border: 1px solid #21262d;
    border-radius: 8px;
    background-color: #0d1117;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #8b949e;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    color: #58a6ff;
    border-bottom: 2px solid #1f6feb;
    background-color: #0d1117;
}

QTabBar::tab:hover:!selected {
    color: #c9d1d9;
    background-color: #161b22;
    border-bottom: 2px solid #30363d;
}

/* --- TreeView / ListView / TableView --- */
QTreeView, QListView, QTableView {
    background-color: #0d1117;
    border: 1px solid #21262d;
    border-radius: 8px;
    padding: 4px;
    color: #c9d1d9;
    outline: none;
}

QTreeView::item, QListView::item {
    padding: 6px 8px;
    border-radius: 6px;
    margin: 1px 2px;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: #1f6feb33;
    color: #58a6ff;
}

QTreeView::item:hover, QListView::item:hover {
    background-color: #1c2128;
}

QTreeView::branch:hover {
    background-color: #1c2128;
}

/* TreeView checkboxes */
QTreeView::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #30363d;
    border-radius: 4px;
    background-color: #0d1117;
}

QTreeView::indicator:hover {
    border-color: #58a6ff;
}

QTreeView::indicator:checked {
    background-color: #1f6feb;
    border-color: #1f6feb;
    image: none;
}

QTreeView::indicator:checked:hover {
    background-color: #388bfd;
}

/* --- HeaderView --- */
QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    border: none;
    border-bottom: 1px solid #21262d;
    border-right: 1px solid #21262d;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 12px;
}

QHeaderView::section:last {
    border-right: none;
}

QHeaderView::section:hover {
    background-color: #1c2128;
    color: #c9d1d9;
}

/* --- CheckBox --- */
QCheckBox {
    spacing: 8px;
    color: #c9d1d9;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #30363d;
    border-radius: 5px;
    background-color: #0d1117;
}

QCheckBox::indicator:hover {
    border-color: #58a6ff;
}

QCheckBox::indicator:checked {
    background-color: #1f6feb;
    border-color: #1f6feb;
}

QCheckBox::indicator:checked:hover {
    background-color: #388bfd;
}

QCheckBox::indicator:disabled {
    border-color: #21262d;
    background-color: #161b22;
}

/* --- RadioButton --- */
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #30363d;
    border-radius: 9px;
    background-color: #0d1117;
}

QRadioButton::indicator:hover {
    border-color: #58a6ff;
}

QRadioButton::indicator:checked {
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, fx: 0.5, fy: 0.5,
        radius: 0.6,
        stop: 0.4 #0d1117,
        stop: 0.5 #1f6feb,
        stop: 0.6 #1f6feb
    );
    border-color: #1f6feb;
}

/* --- ProgressBar --- */
QProgressBar {
    background-color: #21262d;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #c9d1d9;
    height: 12px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1f6feb, stop:1 #58a6ff);
    border-radius: 6px;
}

/* --- ScrollArea --- */
QScrollArea {
    border: none;
    background-color: transparent;
}

/* --- GroupBox --- */
QGroupBox {
    border: 1px solid #21262d;
    border-radius: 10px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    color: #c9d1d9;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    padding: 0 6px;
    color: #58a6ff;
}

/* --- Label --- */
QLabel {
    color: #c9d1d9;
    background: transparent;
}

QLabel#titleLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
}

QLabel#subtitleLabel {
    color: #8b949e;
    font-size: 13px;
}

/* --- ToolTip --- */
QToolTip {
    background-color: #1c2128;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 6px 10px;
    color: #c9d1d9;
    font-size: 12px;
}

/* --- StatusBar --- */
QStatusBar {
    background-color: #0d1117;
    border-top: 1px solid #21262d;
    color: #484f58;
    font-size: 12px;
}

/* --- Dialog --- */
QDialog {
    background-color: #0d1117;
}

/* --- DockWidget --- */
QDockWidget::title {
    background-color: #161b22;
    border-bottom: 1px solid #21262d;
    padding: 8px;
    color: #c9d1d9;
    font-weight: 600;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #30363d;
}

/* --- MainWindow separator --- */
QMainWindow::separator {
    background-color: #21262d;
    width: 1px;
    height: 1px;
}

QMainWindow::separator:hover {
    background-color: #1f6feb;
}

/* --- MdiArea --- */
QMdiArea {
    background-color: #0d1117;
    border: none;
}

QMdiArea QScrollBar:vertical, QMdiArea QScrollBar:horizontal {
    background: transparent;
}

/* --- Quit Button (sidebar) --- */
QPushButton#quitButton, QToolButton#quitButton {
    background-color: #da363311;
    border: 1px solid #f8514944;
    color: #f85149;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton#quitButton:hover, QToolButton#quitButton:hover {
    background-color: #f8514922;
    border-color: #f85149;
    color: #ff7b72;
}

QPushButton#quitButton:pressed, QToolButton#quitButton:pressed {
    background-color: #f8514933;
    border-color: #f85149;
}

/* --- Sidebar danger button --- */
QToolButton#dangerButton {
    background-color: #da363311;
    border: 1px solid #f8514944;
    color: #f85149;
    border-radius: 8px;
    font-weight: 600;
}

QToolButton#dangerButton:hover {
    background-color: #f8514922;
    border-color: #f85149;
    color: #ff7b72;
}

/* --- Sidebar primary button --- */
QToolButton#primaryButton {
    background-color: #1f6feb;
    border: 1px solid #388bfd;
    color: #ffffff;
}

QToolButton#primaryButton:hover {
    background-color: #388bfd;
}

/* --- Alternating row colors --- */
QTreeView, QTreeWidget {
    alternate-background-color: #161b22;
}


/* ===========================================
   Sidebar-specific overrides
   =========================================== */

/* Setup button */
QToolButton[toolTip*="Configure"] {
    background-color: transparent;
    color: #8b949e;
    border: 1px solid transparent;
    border-radius: 8px;
}
QToolButton[toolTip*="Configure"]:hover {
    background-color: #1c2128;
    border: 1px solid #30363d;
    color: #c9d1d9;
}

/* Stop All (danger) */
QToolButton#dangerBtn {
    background-color: #da363311;
    border: 1px solid #f8514944;
    color: #f85149;
    border-radius: 8px;
    font-weight: 600;
}
QToolButton#dangerBtn:hover {
    background-color: #f8514922;
    border-color: #f85149;
    color: #ff7b72;
}

/* Quit button */
QToolButton#quitBtn {
    background-color: transparent;
    border: 1px solid #30363d;
    color: #8b949e;
    border-radius: 8px;
    font-weight: 600;
}
QToolButton#quitBtn:hover {
    background-color: #f8514922;
    border-color: #f8514966;
    color: #f85149;
}

/* Running app kill buttons */
QToolButton#appKillBtn {
    background: #da363322;
    border: 1px solid #f8514944;
    border-radius: 10px;
    color: #f85149;
    font-weight: bold;
    font-size: 11px;
}
QToolButton#appKillBtn:hover {
    background: #f8514933;
    border-color: #f85149;
}

/* ===========================================
   Light theme overrides (applied only when
   no dark theme is active — uses system colors)
   =========================================== */

/* --- Running apps button --- */
QToolButton#runningBtn {
    background-color: #1f6feb11;
    border: 1px solid #1f6feb44;
    color: #58a6ff;
    border-radius: 8px;
    font-weight: 600;
}
QToolButton#runningBtn:hover {
    background-color: #1f6feb22;
    border-color: #1f6feb;
}
QToolButton#runningBtn[toolTip*="Running"] {
    background-color: #1f6feb11;
}



/* === Toolbar unified look === */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1e2430, stop:1 #171c24);
    border: none;
    spacing: 2px;
    padding: 3px 6px;
}

QToolBar::separator {
    width: 1px;
    background: #2a3040;
    margin: 4px 4px;
}

/* === Menu button === */
QToolButton#menuBtn {
    background: transparent;
    border: 1px solid #2a3040;
    border-radius: 6px;
    color: #8b949e;
    padding: 4px 10px;
    font-weight: 500;
}
QToolButton#menuBtn:hover {
    background: #1c2128;
    border-color: #3d444d;
    color: #c9d1d9;
}

/* === Stop All unified split button === */
QToolButton#stopAllBtn {
    background: #b62324;
    border: none;
    border-right: 1px solid #992020;
    border-radius: 6px 0 0 6px;
    color: #ffffff;
    font-weight: 600;
    padding: 5px 14px;
    font-size: 12px;
}
QToolButton#stopAllBtn:hover {
    background: #d42b2c;
}
QToolButton#stopAllBtn:pressed {
    background: #992020;
}

QToolButton#killDropdownBtn {
    background: #992020;
    border: none;
    border-radius: 0 6px 6px 0;
    color: #ffffff;
    font-size: 10px;
    padding: 5px 4px;
    font-weight: bold;
    min-width: 16px;
    max-width: 16px;
}
QToolButton#killDropdownBtn:hover {
    background: #d42b2c;
}

QToolButton#killDropdownBtn::menu-indicator {
    image: none;
    width: 0px;
}

/* === Plugin launch buttons === */
QToolButton#pluginBtn {
    background: transparent;
    border: 1px solid #2a3040;
    border-radius: 6px;
    color: #8b949e;
    padding: 4px 10px;
}
QToolButton#pluginBtn:hover {
    background: #1c2128;
    border-color: #3d444d;
    color: #c9d1d9;
}
QToolButton#pluginBtn:pressed {
    background: #1f6feb22;
    color: #58a6ff;
}
